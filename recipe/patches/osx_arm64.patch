+ASTERINTEGER DEFP( MEMPID, mempid, ASTERINTEGER *val ) {
+    task_vm_info_data_t info;
+    mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+    if ( task_info( mach_task_self(), TASK_VM_INFO, (task_info_t)&info, &count ) !=
+         KERN_SUCCESS ) {
+        return -1;
+    }
+    /* VmSize */
+    val[0] = (ASTERINTEGER)( info.phys_footprint / 1024 );
+    /* VmPeak */
+    val[1] = (ASTERINTEGER)( info.ledger_phys_footprint_peak / 1024 );
+    return 0;
+}
