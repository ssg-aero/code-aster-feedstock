diff --git a/waftools/ext_aster.py b/waftools/ext_aster.py
index 91ce24e6a8..309eaf9f89 100644
--- a/waftools/ext_aster.py
+++ b/waftools/ext_aster.py
@@ -338,6 +338,58 @@ def configure(self):
         self.end_msg("enabled")
 
 
+@Configure.conf
+def check_darwin_shlib(self):
+    """macOS: the shared libraries have circular dependencies (bibfor <-> bibc/bibcxx)
+    and symbols resolved when libaster is loaded, as allowed by ELF on Linux.
+    Must be called once the compilers are loaded."""
+    if self.env.DEST_OS != "darwin":
+        return
+    self.start_msg("Setting up macOS shared libraries")
+    flags = ["-Wl,-undefined,dynamic_lookup"]
+    for var in ("LINKFLAGS_cshlib", "LINKFLAGS_cxxshlib", "LINKFLAGS_fcshlib"):
+        self.env.append_unique(var, flags)
+    # equivalent of '--as-needed' that would drop the libraries needed by libaster
+    for var in ("LINKFLAGS", "LDFLAGS"):
+        self.env[var] = [i for i in Utils.to_list(self.env[var]) if i != "-Wl,-dead_strip_dylibs"]
+    self.end_msg(flags)
+
+
+@TaskGen.feature("c", "cxx", "fc")
+@TaskGen.after_method("propagate_uselib_vars")
+def darwin_rpath_origin(self):
+    """macOS: '$ORIGIN' is spelled '@loader_path'.
+    Libraries installed out of ASTERLIBDIR (in site-packages) also need to find
+    those of ASTERLIBDIR, as LD_LIBRARY_PATH does on Linux."""
+    if self.env.DEST_OS == "darwin" and self.env.RPATH:
+        self.env.RPATH = [i.replace("$ORIGIN", "@loader_path") for i in self.env.RPATH]
+        inst = getattr(self, "install_path", None)
+        libdir = self.env.ASTERLIBDIR
+        if isinstance(inst, str) and libdir and osp.normpath(inst) != osp.normpath(libdir):
+            self.env.append_unique("RPATH", "@loader_path/" + osp.relpath(libdir, inst))
+
+
+@TaskGen.feature("cshlib", "cxxshlib", "fcshlib")
+@TaskGen.after_method("apply_link")
+def darwin_install_name(self):
+    """macOS: identify the libraries by '@rpath/<name>' instead of their build path."""
+    if self.env.DEST_OS == "darwin" and getattr(self, "link_task", None):
+        name = self.link_task.outputs[0].name
+        self.env.append_value("LINKFLAGS", ["-Wl,-install_name,@rpath/" + name])
+
+
+@TaskGen.feature("cshlib", "cxxshlib", "fcshlib")
+@TaskGen.after_method("apply_link")
+def darwin_link_with_dylib(self):
+    """Add the library of another task generator as link input, without inheriting
+    its 'use' (compilation flags)."""
+    name = getattr(self, "link_with_dylib", None)
+    if name:
+        other = self.bld.get_tgen_by_name(name)
+        other.post()
+        self.link_task.inputs.append(other.link_task.outputs[0])
+
+
